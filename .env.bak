cat > /home/sergio/Escritorio/coba-asistencias/.env <<'EOF'
APP_NAME="COBAO Asistencias"
APP_ENV=local
APP_KEY=base64:YX+dLr2tWXHQHo3QMq4ZpMBsXQzmfhC1T1cMEOeluGo=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
